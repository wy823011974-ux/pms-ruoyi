# ============================================
# 项目管理系统 v2.0 — 环境变量模板
# ============================================
# 使用方法：
#   1. 复制此文件为 .env（不要提交到 Git）
#      cp .env.example .env
#   2. 修改 .env 中的密码为你的真实密码
#   3. 生产环境必须修改所有默认值！
# ============================================

# === MySQL 数据库 ===
MYSQL_ROOT_PASSWORD=请修改_MySQL_root密码
MYSQL_DATABASE=pms_db
MYSQL_USER=pms_user
MYSQL_PASSWORD=请修改_数据库密码

# === JWT 签名密钥（至少64位随机字符串）===
# 生成方式：openssl rand -base64 48
JWT_SECRET=请修改_64位以上随机字符串
JWT_EXPIRATION=480

# === 应用配置 ===
SPRING_PROFILES_ACTIVE=docker
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=52428800
